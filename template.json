{
  "name": "Firecrawl v2 Web Data API for AI",
  "description": "Turn websites into clean markdown and JSON for LLMs. Self-hosted workers.",
  "category": "AI/ML",
  "tags": [
    "firecrawl",
    "web-scraping",
    "crawler",
    "markdown",
    "llm",
    "rag",
    "playwright"
  ],
  "upstream": {
    "repo": "firecrawl/firecrawl",
    "version": "v2.11.0 (image 2.11.504)",
    "checked": "2026-10-10"
  },
  "services": {
    "firecrawl": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/caddy.svg",
      "source": {
        "repo": "baranberkay96/firecrawl-railway",
        "rootDirectory": "/services/gateway"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/healthz",
      "healthcheckTimeout": 60,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": true,
      "targetPort": 8080,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "Gateway listen port (public domain target).",
          "required": false
        },
        "FIRECRAWL_API_KEY": {
          "defaultValue": "fc-${{secret(32, \"abcdef0123456789\")}}",
          "description": "API key clients must send as 'Authorization: Bearer <key>'. Use it as the SDK api_key.",
          "required": false
        },
        "FIRECRAWL_UPSTREAM": {
          "defaultValue": "${{firecrawl-api.RAILWAY_PRIVATE_DOMAIN}}:3002",
          "description": "Private address of firecrawl-api.",
          "required": false
        }
      }
    },
    "firecrawl-api": {
      "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons@main/svg/firecrawl.svg",
      "source": {
        "image": "ghcr.io/firecrawl/firecrawl:2.11.504"
      },
      "startCommand": "node dist/src/index.js",
      "preDeployCommand": null,
      "healthcheckPath": "/v0/health/readiness",
      "healthcheckTimeout": 300,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": 3002,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "HOST": {
          "defaultValue": "::",
          "description": "Bind address; :: accepts IPv4 and IPv6 from the gateway.",
          "required": false
        },
        "PORT": {
          "defaultValue": "3002",
          "description": "API port (private).",
          "required": false
        },
        "ENV": {
          "defaultValue": "local",
          "description": "Self-hosted mode (same value as the upstream docker-compose).",
          "required": false
        },
        "LOGGING_LEVEL": {
          "defaultValue": "INFO",
          "description": "Log level.",
          "required": false
        },
        "USE_DB_AUTHENTICATION": {
          "defaultValue": "false",
          "description": "Supabase auth is not available for self-hosting; the firecrawl gateway enforces the API key instead.",
          "required": false
        },
        "REDIS_URL": {
          "defaultValue": "${{Redis.REDIS_URL}}",
          "description": "Redis for BullMQ queues and crawl state.",
          "required": false
        },
        "REDIS_RATE_LIMIT_URL": {
          "defaultValue": "${{Redis.REDIS_URL}}",
          "description": "Redis for rate limiting.",
          "required": false
        },
        "NUQ_DATABASE_URL": {
          "defaultValue": "postgresql://postgres:${{nuq-postgres.POSTGRES_PASSWORD}}@${{nuq-postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/postgres",
          "description": "NuQ job queue database (nuq-postgres, private network).",
          "required": false
        },
        "NUQ_DATABASE_URL_LISTEN": {
          "defaultValue": "${{NUQ_DATABASE_URL}}",
          "description": "Direct connection used for LISTEN/NOTIFY (same database).",
          "required": false
        },
        "NUQ_RABBITMQ_URL": {
          "defaultValue": "amqp://firecrawl:${{RabbitMQ.RABBITMQ_DEFAULT_PASS}}@${{RabbitMQ.RAILWAY_PRIVATE_DOMAIN}}:5672",
          "description": "RabbitMQ used by NuQ to wake workers when jobs arrive.",
          "required": false
        },
        "PLAYWRIGHT_MICROSERVICE_URL": {
          "defaultValue": "http://${{playwright-service.RAILWAY_PRIVATE_DOMAIN}}:3000/scrape",
          "description": "Browser rendering service (private network).",
          "required": false
        },
        "BULL_AUTH_KEY": {
          "defaultValue": "${{secret(32, \"abcdef0123456789\")}}",
          "description": "Secret path segment for the queue dashboard: /admin/<BULL_AUTH_KEY>/queues.",
          "required": false
        },
        "NUM_WORKERS_PER_QUEUE": {
          "defaultValue": "8",
          "description": "BullMQ concurrency per queue (upstream default).",
          "required": false
        },
        "CRAWL_CONCURRENT_REQUESTS": {
          "defaultValue": "10",
          "description": "Concurrent requests per crawl (upstream default).",
          "required": false
        },
        "MAX_CONCURRENT_JOBS": {
          "defaultValue": "5",
          "description": "Max concurrent jobs per team (upstream default).",
          "required": false
        },
        "BROWSER_POOL_SIZE": {
          "defaultValue": "5",
          "description": "Browser pool size (upstream default).",
          "required": false
        },
        "OPENAI_API_KEY": {
          "defaultValue": "",
          "description": "Optional. Enables LLM features (JSON/extract formats, /extract). Leave empty to disable.",
          "required": false
        },
        "OPENAI_BASE_URL": {
          "defaultValue": "",
          "description": "Optional. OpenAI-compatible base URL (e.g. a LiteLLM gateway).",
          "required": false
        },
        "MODEL_NAME": {
          "defaultValue": "",
          "description": "Optional. Model used for extraction (e.g. gpt-4o-mini).",
          "required": false
        },
        "MODEL_EMBEDDING_NAME": {
          "defaultValue": "",
          "description": "Optional. Embedding model name.",
          "required": false
        },
        "OLLAMA_BASE_URL": {
          "defaultValue": "",
          "description": "Optional (experimental upstream). Ollama API base URL instead of OpenAI.",
          "required": false
        },
        "PROXY_SERVER": {
          "defaultValue": "",
          "description": "Optional. Outbound HTTP proxy for fetches (http://host:port).",
          "required": false
        },
        "PROXY_USERNAME": {
          "defaultValue": "",
          "description": "Optional. Proxy username.",
          "required": false
        },
        "PROXY_PASSWORD": {
          "defaultValue": "",
          "description": "Optional. Proxy password.",
          "required": false
        },
        "SEARXNG_ENDPOINT": {
          "defaultValue": "",
          "description": "Optional. SearXNG instance (JSON enabled) for /search instead of direct Google.",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Let in-flight scrape requests finish during redeploys.",
          "required": false
        }
      }
    },
