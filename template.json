      },
      "startCommand": "docker-entrypoint.sh postgres -c max_wal_size=1GB -c min_wal_size=128MB -c wal_buffers=16MB",
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "POSTGRES_USER": {
          "defaultValue": "postgres",
          "description": "Superuser created on first boot (pg_cron jobs run in the postgres database).",
          "required": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Database password, generated.",
          "required": false
        },
        "POSTGRES_DB": {
          "defaultValue": "postgres",
          "description": "Must stay 'postgres': the image configures cron.database_name = 'postgres' and installs the NuQ schema there.",
          "required": false
        },
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Data directory inside the volume (avoids the volume's lost+found).",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Allow Postgres to shut down cleanly.",
