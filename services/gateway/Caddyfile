{
	admin off
	auto_https off
	# Railway terminates TLS at its edge and forwards to this container.
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	# Gateway liveness (Railway healthcheck). Does not touch the API.
	handle /healthz {
		respond "ok" 200
	}

	# Bull queue dashboard. Upstream protects it with a secret path segment:
	# /admin/<BULL_AUTH_KEY>/queues
	handle /admin/* {
		reverse_proxy {$FIRECRAWL_UPSTREAM}
	}

	# Everything else requires the API key that Firecrawl SDKs send as a bearer token.
	@authorized header Authorization "Bearer {$FIRECRAWL_API_KEY}"
	handle @authorized {
		reverse_proxy {$FIRECRAWL_UPSTREAM} {
			# stream responses (SSE / large crawl results) without buffering
			flush_interval -1
		}
	}

	handle {
		header Content-Type "application/json"
		respond `{"success":false,"error":"Unauthorized: send 'Authorization: Bearer <FIRECRAWL_API_KEY>'"}` 401
	}
}
